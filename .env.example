# Service ports
# BACKEND_PORT/BACKEND_PORT_MAX form a host port range (default 8000-8009).
# With one replica (standalone, or scaleout --scale backend=1) it binds
# BACKEND_PORT as before. Scaling to N replicas (scaleout only) publishes
# each on the next free port in the range (8000, 8001, ...) — raise
# BACKEND_PORT_MAX if you need more than 10 replicas.
BACKEND_PORT=8000
BACKEND_PORT_MAX=8009
FRONTEND_PORT=3000

# Remote polling default interval (seconds)
DEFAULT_POLL_INTERVAL=300

# GitHub personal access token (optional)
# Increases rate limit from 60/hr to 5000/hr and enables private repo access
# GITHUB_TOKEN=ghp_...

# GitLab personal access token (optional)
# Enables private project access on gitlab.com and self-hosted GitLab instances
# GITLAB_TOKEN=glpat-...

# Master key for encrypting per-source access tokens at rest (optional)
# Per-source tokens entered via the source registration UI/API are stored
# encrypted, never in plaintext. If unset, the backend generates one on first
# boot and persists it to the sqlite_data volume (alongside db.sqlite3), so
# self-hosted single-instance deployments work with zero key management.
# Set this explicitly only if you need the key to survive a volume wipe, or
# to share one key across multiple backend instances.
# TOKEN_ENCRYPTION_KEY=<base64 Fernet key, e.g. output of Fernet.generate_key()>

# Backend CPU/memory ceiling (prod stack only — see docker-compose.prod.yml)
# Prevents a large embedding/indexing job from starving the host or the
# other containers.
BACKEND_CPU_LIMIT=2
BACKEND_MEMORY_LIMIT=2g

# Corporate/on-premises proxy (optional)
# Used for both image builds (npm install, pip install, embedding model
# download) and the backend container's runtime outbound requests to
# remote doc sources. Leave unset when direct internet access is available.
# HTTP_PROXY=http://proxy.internal.example.com:8080
# HTTPS_PROXY=http://proxy.internal.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# Corporate CA certificate (optional, no env var needed)
# If your corporate proxy above intercepts TLS, pip/npm installs and the
# backend's outbound HTTPS requests will fail certificate verification
# unless your CA is trusted. Drop your PEM-encoded root/intermediate cert(s)
# as backend/certs/*.crt and frontend/certs/*.crt (both gitignored) before
# `docker compose build` — leaving those directories empty is a no-op.
